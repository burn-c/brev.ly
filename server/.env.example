PORT=3333
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brevly

# Storage — suporta Cloudflare R2 ou AWS S3
# R2 e S3 são S3-compatíveis (mesmo @aws-sdk/client-s3); mudam endpoint e credenciais.

STORAGE_PROVIDER=cloudflare   # cloudflare | aws

# Cloudflare R2 (local ou produção via R2)
# Para obter o par S3: dash.cloudflare.com → R2 → Manage R2 API Tokens → Create API Token
# (permissão Object Read & Write, aplicada ao bucket). URL pública via
# `wrangler r2 bucket dev-url enable <bucket>` → https://pub-<hash>.r2.dev
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
CLOUDFLARE_PUBLIC_URL=""

# AWS S3 (deploy real — produção usa S3 + CloudFront)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_CDN_URL=""
AWS_ENDPOINT=""

FRONTEND_URL="http://localhost:5173"
